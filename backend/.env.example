APP_NAME=EcoEvent 360 API
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
DATABASE_URL=
MIGRATION_DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=

CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
R2_PRIVATE_PREFIX=private
R2_PUBLIC_PREFIX=public
R2_SIGNED_URL_EXPIRES_SECONDS=300
LOCAL_PRIVATE_STORAGE_ROOT=uploads/private
LOCAL_PUBLIC_STORAGE_ROOT=uploads/public
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
REDIS_URL=
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_LOGIN_IP=10/60
RATE_LIMIT_LOGIN_IDENTITY=5/300
RATE_LIMIT_PUBLIC_READ=60/60
RATE_LIMIT_PUBLIC_SUBMIT=10/300
RATE_LIMIT_BIKE_CODE=30/60
RATE_LIMIT_SENSITIVE_USER=60/60
RATE_LIMIT_AI_INTERPRETATION=5/300
RATE_LIMIT_AI_REPORTS=10/300

# Optional central AI platform. Keep the API key backend-only.
AI_ENABLED=false
AI_REPORTS_ENABLED=true
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.2
AI_REPORT_PROVIDER=openai
AI_REPORT_MODEL=gpt-5.6-luna
AI_REPORT_FAST_MODEL=gpt-5.6-luna
# Configure a stronger account-available model for whole-report editorial work.
AI_REPORT_EDITORIAL_MODEL=
AI_REPORT_AUDIT_MODEL=
AI_REPORT_VISION_MODEL=
AI_REPORT_FAST_MAX_OUTPUT_TOKENS=1800
AI_REPORT_EDITORIAL_MAX_OUTPUT_TOKENS=4000
AI_REPORT_API_KEY=
AI_REPORT_BASE_URL=https://api.openai.com/v1
AI_REPORT_TIMEOUT_SECONDS=90
AI_REPORT_MAX_OUTPUT_TOKENS=4000
AI_REPORT_TEMPERATURE=0.2
AI_REPORT_MONTHLY_BUDGET_USD=10
AI_REPORT_PENDING_STALE_MINUTES=15
# Override opcional por modelo, USD/millón. Luna por defecto: input 0.20, cached_input 0.02, output 1.20.
AI_REPORT_PRICING_JSON=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
